//@version=6
// FracDiff Gate (5m, TREND-sense) — matches the backtest's entry gate.
//
// IMPORTANT: apply this on a 5-MINUTE chart. The backtest's edge comes from the
// 5m FracDiff, NOT the daily "GC1! Daily" indicator. This computes on the chart's
// own bars, so a 5m chart = the validated signal.
//
// TREND sense (the only direction that tested profitable, PF ~1.7-1.8 fwd):
//   LONG fade (buying the lower VDL band) is confirmed when z >= +band.
//   SHORT fade (selling the upper band)   is confirmed when z <= -band.
// This is the OPPOSITE of the usual EC up/down triangles — ignore those; use the
// shaded regime / z sign here.
//
// Math is a line-for-line match of indicators/fracdiff.py (d=0.45, N=100,
// z_len=100, band=1.0, src=close, population stdev, fast-calc weight cutoff 1e-3).
indicator("FracDiff Gate 5m (trend-sense)", shorttitle="FDgate5m", overlay=false)

d     = input.float(0.45, "Integration Order (d)")
N     = input.int(100,   "Lag Truncation (N)")
zlen  = input.int(100,   "Z-Score Lookback")
bw    = input.float(1.0, "Band Width (sigma)")
fast  = input.bool(true, "Fast Calculation")
src   = input.source(close, "Price Source")   // keep CLOSE to match the backtest

// --- binomial fractional-difference weights (computed once) ---------------
var float[] w = array.new_float()
if barstate.isfirst
    thresh = fast ? 1e-3 : 1e-6
    array.push(w, 1.0)
    wk = 1.0
    for k = 1 to N
        wk := wk * (k - 1 - d) / k
        if math.abs(wk) < thresh
            break
        array.push(w, wk)
effN = array.size(w) - 1

// --- fractional differencing: fd[i] = sum_k w[k]*src[i-k] -----------------
float fd = na
if bar_index >= effN
    float s = 0.0
    for k = 0 to effN
        s += array.get(w, k) * src[k]
    fd := s

// --- z-score (population stdev, like Pine ta.stdev default) ----------------
fdmean = ta.sma(fd, zlen)
fdstd  = ta.stdev(fd, zlen)
z      = (fd - fdmean) / fdstd

longOK  = z >= bw        // LONG-fade confirmed (trend sense)
shortOK = z <= -bw       // SHORT-fade confirmed (trend sense)

plot(z, "z", color=color.new(color.gray, 0), linewidth=2)
hline(0,   "0",      color=color.new(color.gray, 50))
hline(bw,  "+band",  color=color.new(color.red, 0),  linestyle=hline.style_dashed)
hline(-bw, "-band",  color=color.new(color.aqua, 0), linestyle=hline.style_dashed)
bgcolor(longOK ? color.new(color.lime, 88) : shortOK ? color.new(color.red, 88) : na)
plotshape(longOK  and not longOK[1],  "LONG-fade OK",  shape.triangleup,   location.bottom, color.lime, size=size.tiny)
plotshape(shortOK and not shortOK[1], "SHORT-fade OK", shape.triangledown, location.top,    color.red,  size=size.tiny)

// status table
var table t = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "z",      text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 0, str.tostring(z, "#.###"), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 1, "band",   text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 1, str.tostring(bw), text_color=color.white, bgcolor=color.new(color.black, 0))
    sigtxt = longOK ? "LONG-fade OK" : shortOK ? "SHORT-fade OK" : "NEUTRAL"
    sigcol = longOK ? color.lime : shortOK ? color.red : color.gray
    table.cell(t, 0, 2, "signal", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 2, sigtxt,   text_color=sigcol,     bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 3, "lags",   text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 3, str.tostring(effN) + "/" + str.tostring(N), text_color=color.white, bgcolor=color.new(color.black, 0))
